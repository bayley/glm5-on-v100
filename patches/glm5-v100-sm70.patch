+    def _dump_debug_prompt(
+        self,
+        request_id: str,
+        endpoint: str,
+        api_request: AnyRequest,
+        engine_input: PromptType | EngineInput,
+        params: SamplingParams | BeamSearchParams | None,
+    ) -> None:
+        """Debug capture (VLLM_DEBUG_DUMP_PROMPTS_DIR): write one JSON file
+        per request containing the ORIGINAL API request body (replayable
+        verbatim — includes the client's system prompt / messages / tools)
+        plus the fully RENDERED engine prompt (post-chat-template text and
+        the exact prompt token ids) and the resolved sampling params.
+
+        Used to capture what clients like Open WebUI actually send so a
+        problematic request can be replayed offline (see replay_prompt.py
+        at the repo root). Best-effort: never raises into the request path.
+        """
+        dump_dir = envs.VLLM_DEBUG_DUMP_PROMPTS_DIR
+        if not dump_dir:
+            return
+        try:
+            os.makedirs(dump_dir, exist_ok=True)
+
+            try:
+                api_request_dump: Any = api_request.model_dump(
+                    mode="json", exclude_unset=True
+                )
+            except Exception:
+                api_request_dump = {"_unserializable_repr": repr(api_request)}
+
+            components = self._extract_prompt_components(engine_input)
+            token_ids = (
+                list(components.token_ids)
+                if components.token_ids is not None
+                else None
+            )
+
+            # The renderer usually tokenizes directly (components.text is
+            # None for chat); detokenize so the dump shows the rendered
+            # chat-template prompt as text too.
+            prompt_text = components.text
+            if prompt_text is None and token_ids is not None:
+                try:
+                    tokenizer = self.renderer.tokenizer
+                    if tokenizer is not None:
+                        prompt_text = tokenizer.decode(token_ids)
+                except Exception:
+                    prompt_text = None
+
+            record = {
+                "timestamp_utc": time.strftime(
+                    "%Y-%m-%dT%H:%M:%SZ", time.gmtime()
+                ),
+                "request_id": request_id,
+                "endpoint": endpoint,
+                "model": getattr(api_request, "model", None),
+                "api_request": api_request_dump,
+                "rendered_prompt": prompt_text,
+                "prompt_token_ids": token_ids,
+                "num_prompt_tokens": (
+                    len(token_ids) if token_ids is not None else None
+                ),
+                "sampling_params": str(params),
+            }
+
+            safe_id = re.sub(r"[^A-Za-z0-9._-]+", "_", request_id)
+            fname = f"{time.strftime('%Y%m%d-%H%M%S', time.gmtime())}_{safe_id}.json"
+            path = os.path.join(dump_dir, fname)
+            tmp_path = path + ".tmp"
+            with open(tmp_path, "w", encoding="utf-8") as f:
+                json.dump(record, f, ensure_ascii=False, indent=2)
+            os.replace(tmp_path, path)
+            logger.info("Dumped prompt debug record for %s to %s", request_id, path)
+        except Exception:
+            logger.exception("Failed to dump prompt debug record for %s", request_id)
+
